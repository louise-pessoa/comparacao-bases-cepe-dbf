# Copie este arquivo para ".env" e ajuste os valores para a sua máquina.
# O ".env" NÃO deve ser versionado (já está no .gitignore).

# Pasta da base oficial da DBF (Drive sincronizado). OBRIGATÓRIA.
# Rodando no Windows:  PASTA_DBF=G:\Meu Drive\DBF\Decretos
# Rodando no WSL2:     PASTA_DBF=/mnt/g/Meu Drive/DBF/Decretos
# (no WSL2 o G: precisa estar montado: sudo mount -t drvfs G: /mnt/g)
PASTA_DBF=

# Pastas de trabalho. Caminhos relativos são resolvidos a partir da raiz do
# projeto. Os valores abaixo são os padrões e podem ser omitidos.
# ATENÇÃO: PASTA_DBF e estas pastas devem ser todas diferentes e nenhuma pode
# ficar dentro de outra. O script se recusa a executar caso contrário, pois o
# descarte de PDFs é definitivo e poderia apagar decretos da base da DBF.
PASTA_TEMP=dados/pendentes
PASTA_CADERNOS=dados/cadernos
PASTA_ERROS=dados/erros
PASTA_OCR=dados/leitura tesseract
PASTA_NORMALIZADOS=dados/normalizados
PASTA_LOGS=logs

# Republicação: pasta LOCAL dos PDFs "(conferir duplicata)" (publicação diferente
# de um arquivo da base gravado antes do registro existir) e o registro das
# publicações gravadas. Os valores abaixo são os padrões. A pasta também não pode
# coincidir com as outras, e o registro não pode ficar dentro da PASTA_DBF.
PASTA_CONFERIR_DUPLICATA=dados/conferir duplicata
REGISTRO_PUBLICACOES=dados/registro_publicacoes.json

# Proxy da rede, se o navegador acessa a internet por um e o Python não (a
# captura dá timeout). Três opções:
#   auto                  (recomendado em rede com proxy automático/PAC) pergunta ao
#                         Windows qual é o proxy a cada captura; só funciona no
#                         Windows e não precisa de ajuste quando a porta muda.
#   http://endereco:porta endereço fixo (a porta pode mudar entre sessões).
#   (em branco)           sem proxy explícito.
# Não coloque senha aqui. Atenção: uma variável HTTPS_PROXY definida na janela do
# PowerShell vale mais que esta linha; se a captura ignorar o "auto", rode
# Remove-Item Env:HTTPS_PROXY e tente de novo.
HTTPS_PROXY=

# Verificação estrita de certificado (padrão: sim). Se o download falhar com
# "CERTIFICATE_VERIFY_FAILED ... Missing Authority Key Identifier" (Python 3.13 ou
# mais novo atrás de um proxy que inspeciona HTTPS), troque para "nao". Só deixa
# de exigir a conformidade estrita do certificado: a cadeia e o nome do servidor
# continuam sendo verificados.
SSL_ESTRITO=sim
